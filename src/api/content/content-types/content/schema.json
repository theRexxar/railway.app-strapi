{
  "kind": "collectionType",
  "collectionName": "contents",
  "info": { "singularName": "content", "pluralName": "contents", "displayName": "Content", "description": "Individual content entries within a content group" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "excerpt": { "type": "text" },
    "body": { "type": "customField", "customField": "plugin::ckeditor5.CKEditor", "options": { "preset": "defaultHtml" }, "required": true },
    "image": { "type": "media", "media": true, "allowedTypes": ["images"] },
    "link": { "type": "string" },
    "content_group": { "type": "relation", "relation": "manyToOne", "target": "api::content-group.content-group" },
    "order": { "type": "integer", "default": 0 },
    "meta_seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}