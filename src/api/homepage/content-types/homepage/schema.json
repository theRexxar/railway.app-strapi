{
  "kind": "singleType",
  "collectionName": "homepage",
  "info": {
    "singularName": "homepage",
    "pluralName": "homepages",
    "displayName": "Homepage",
    "description": "Homepage editorial content"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "section.hero",
      "required": true
    },
    "persona_modal_title": {
      "type": "string"
    },
    "persona_modal_text": {
      "type": "text"
    },
    "persona_cards": {
      "type": "component",
      "repeatable": true,
      "component": "section.persona-card"
    },
    "service_section_title": {
      "type": "string"
    },
    "service_section_desc": {
      "type": "text"
    },
    "featured_services": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::service-info.service-info"
    },
    "country_section_title": {
      "type": "string"
    },
    "featured_countries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::country.country"
    },
    "training_section_title": {
      "type": "string"
    },
    "featured_courses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::course.course"
    },
    "article_section_title": {
      "type": "string"
    },
    "featured_articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article"
    },
    "meta_seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}