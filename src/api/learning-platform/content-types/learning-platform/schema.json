{
  "kind": "collectionType",
  "collectionName": "learning_platforms",
  "info": { "singularName": "learning-platform", "pluralName": "learning-platforms", "displayName": "Learning Platform", "description": "Training provider platforms" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "name": { "type": "string", "required": true, "unique": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "logo": { "type": "media", "media": true, "allowedTypes": ["images"] },
    "url": { "type": "string" },
    "courses": { "type": "relation", "relation": "oneToMany", "target": "api::course.course", "mappedBy": "learning_platform" }
  }
}