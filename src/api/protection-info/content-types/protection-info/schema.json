{
  "kind": "collectionType",
  "collectionName": "protection_infos",
  "info": { "singularName": "protection-info", "pluralName": "protection-infos", "displayName": "Protection Info", "description": "Protection info entries for Penting Diketahui section" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "excerpt": { "type": "text" },
    "description": { "type": "customField", "customField": "plugin::ckeditor5.CKEditor", "options": { "preset": "defaultHtml" }, "required": true },
    "image": { "type": "media", "media": true, "allowedTypes": ["images"] },
    "is_featured": { "type": "boolean", "default": false },
    "order": { "type": "integer", "default": 0 },
    "meta_seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}
