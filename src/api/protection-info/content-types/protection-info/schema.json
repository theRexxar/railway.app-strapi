{
  "kind": "collectionType",
  "collectionName": "protection_infos",
  "info": { "singularName": "protection-info", "pluralName": "protection-infos", "displayName": "Protection Info", "description": "Protection info entries for Penting Diketahui section" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "description": { "type": "customField", "customField": "plugin::ckeditor5.CKEditor", "options": { "preset": "defaultHtml" } },
    "content": { "type": "customField", "customField": "plugin::ckeditor5.CKEditor", "options": { "preset": "defaultHtml" }, "required": true },
    "icon": { "type": "media", "media": true, "allowedTypes": ["images"] },
    "order": { "type": "integer", "default": 0 }
  }
}
