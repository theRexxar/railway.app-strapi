{
  "kind": "collectionType",
  "collectionName": "faq_categories",
  "info": { "singularName": "faq-category", "pluralName": "faq-categories", "displayName": "FAQ Category", "description": "FAQ grouping categories (e.g. Tentang Jari PMI, Pendaftaran, Pelatihan)" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "name": { "type": "string", "required": true, "unique": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "order": { "type": "integer", "default": 0 },
    "faqs": { "type": "relation", "relation": "oneToMany", "target": "api::faq.faq", "mappedBy": "faq_category" }
  }
}
