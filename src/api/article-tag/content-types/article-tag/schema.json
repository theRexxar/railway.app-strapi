{
  "kind": "collectionType",
  "collectionName": "article_tags",
  "info": { "singularName": "article-tag", "pluralName": "article-tags", "displayName": "Article Tag", "description": "Article tags for filtering" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "name": { "type": "string", "required": true, "unique": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "articles": { "type": "relation", "relation": "manyToMany", "target": "api::article.article", "mappedBy": "article_tags" }
  }
}