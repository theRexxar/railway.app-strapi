{
  "kind": "collectionType",
  "collectionName": "announcements",
  "info": { "singularName": "announcement", "pluralName": "announcements", "displayName": "Announcement", "description": "Announcement slider for Informasi Layanan section" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "name": { "type": "string", "required": true, "unique": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "excerpt": { "type": "text" },
    "description": { "type": "customField", "customField": "plugin::ckeditor5.CKEditor", "options": { "preset": "defaultHtml" }, "required": true },
    "image": { "type": "media", "media": true, "allowedTypes": ["images"], "required": true },
    "link": { "type": "string", "required": true },
    "start_date": { "type": "datetime", "required": true },
    "end_date": { "type": "datetime" },
    "personas": { "type": "relation", "relation": "manyToMany", "target": "api::persona.persona" },
    "order": { "type": "integer", "default": 0 }
  }
}
