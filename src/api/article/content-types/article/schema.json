{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": { "singularName": "article", "pluralName": "articles", "displayName": "Article", "description": "News and informational articles" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true, "unique": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "excerpt": { "type": "text", "required": true },
    "content": { "type": "customField", "customField": "plugin::ckeditor.CKEditor", "required": true },
    "cover_image": { "type": "media", "media": true, "allowedTypes": ["images"], "required": true },
    "article_category": { "type": "relation", "relation": "manyToOne", "target": "api::article-category.article-category", "inversedBy": "articles" },
    "article_tags": { "type": "relation", "relation": "manyToMany", "target": "api::article-tag.article-tag", "inversedBy": "articles" },
    "author": { "type": "relation", "relation": "manyToOne", "target": "api::author.author", "inversedBy": "articles" },
    "meta_seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}