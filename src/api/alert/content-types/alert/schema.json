{
  "kind": "collectionType",
  "collectionName": "alerts",
  "info": { "singularName": "alert", "pluralName": "alerts", "displayName": "Alert", "description": "Site-wide alert banners" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "type": { "type": "enumeration", "enum": ["info", "warning", "success", "error"], "required": true },
    "title": { "type": "string", "required": true },
    "message": { "type": "customField", "customField": "plugin::ckeditor5.CKEditor", "options": { "preset": "defaultHtml" }, "required": true },
    "icon": { "type": "media", "media": true, "allowedTypes": ["images"] },
    "image": { "type": "media", "media": true, "allowedTypes": ["images"] },
    "link": { "type": "string" },
    "personas": { "type": "relation", "relation": "manyToMany", "target": "api::persona.persona" },
    "active": { "type": "boolean", "default": true },
    "start_date": { "type": "datetime" },
    "end_date": { "type": "datetime" }
  }
}
