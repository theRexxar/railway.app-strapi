{
  "kind": "collectionType",
  "collectionName": "course_categories",
  "info": { "singularName": "course-category", "pluralName": "course-categories", "displayName": "Course Category", "description": "Course categories for filtering" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "name": { "type": "string", "required": true, "unique": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "courses": { "type": "relation", "relation": "oneToMany", "target": "api::course.course", "mappedBy": "course_category" }
  }
}