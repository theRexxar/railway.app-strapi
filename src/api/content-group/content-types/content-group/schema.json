{
  "kind": "collectionType",
  "collectionName": "content_groups",
  "info": { "singularName": "content-group", "pluralName": "content-groups", "displayName": "Content Group", "description": "Groups content under a themed section" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true, "unique": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "description": { "type": "text" },
    "image": { "type": "media", "media": true, "allowedTypes": ["images"] },
    "content_type": { "type": "enumeration", "enum": ["content", "country", "service-info", "protection-info", "course"], "required": true },
    "contents": { "type": "relation", "relation": "manyToMany", "target": "api::content.content" },
    "countries": { "type": "relation", "relation": "manyToMany", "target": "api::country.country" },
    "service_infos": { "type": "relation", "relation": "manyToMany", "target": "api::service-info.service-info" },
    "protection_infos": { "type": "relation", "relation": "manyToMany", "target": "api::protection-info.protection-info" },
    "courses": { "type": "relation", "relation": "manyToMany", "target": "api::course.course" },
    "personas": { "type": "relation", "relation": "manyToMany", "target": "api::persona.persona" },
    "order": { "type": "integer", "default": 0 },
    "meta_seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}