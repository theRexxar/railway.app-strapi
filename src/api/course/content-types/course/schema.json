{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": { "singularName": "course", "pluralName": "courses", "displayName": "Course", "description": "Training/pelatihan entries" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "name": { "type": "string", "required": true, "unique": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "excerpt": { "type": "text" },
    "description": { "type": "richtext" },
    "image": { "type": "media", "media": true, "allowedTypes": ["images"], "required": true },
    "price": { "type": "decimal" },
    "link": { "type": "string", "required": true },
    "course_category": { "type": "relation", "relation": "manyToOne", "target": "api::course-category.course-category", "inversedBy": "courses" },
    "course_tags": { "type": "relation", "relation": "manyToMany", "target": "api::course-tag.course-tag", "inversedBy": "courses" },
    "learning_platform": { "type": "relation", "relation": "manyToOne", "target": "api::learning-platform.learning-platform", "inversedBy": "courses" },
    "countries": { "type": "relation", "relation": "manyToMany", "target": "api::country.country" },
    "target_personas": { "type": "json" },
    "is_featured": { "type": "boolean", "default": false },
    "meta_seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}