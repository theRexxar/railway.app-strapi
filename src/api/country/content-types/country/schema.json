{
  "kind": "collectionType",
  "collectionName": "countries",
  "info": { "singularName": "country", "pluralName": "countries", "displayName": "Country", "description": "Destination countries for migrant workers" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "name": { "type": "string", "required": true, "unique": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "flag": { "type": "media", "media": true, "allowedTypes": ["images"], "required": true },
    "image": { "type": "media", "media": true, "allowedTypes": ["images"] },
    "description": { "type": "customField", "customField": "plugin::ckeditor5.CKEditor", "options": { "preset": "defaultHtml" } },
    "region": { "type": "enumeration", "enum": ["asia", "middle-east", "europe", "africa", "americas", "oceania"] },
    "is_featured": { "type": "boolean", "default": false },
    "order": { "type": "integer", "default": 0 },
    "vacancy_count": { "type": "integer" },
    "salary_avg": { "type": "text" },
    "pmi_count": { "type": "integer" },
    "meta_seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}
